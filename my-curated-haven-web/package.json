{
  "name": "my-curated-haven-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.5.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:homepage:unit": "node --experimental-strip-types --test tests/homepage/*.test.mjs",
    "test:data:unit": "node --experimental-strip-types --test tests/data/*.test.mjs",
    "test:phase10:unit": "node --test tests/phase10/target-guard.test.mjs tests/phase10/results.test.mjs",
    "report:phase10": "node scripts/phase10-results.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:phase10:unit && npm run test:homepage:unit && npm run test:data:unit && npm run build && npm run test:e2e",
    "check:routes": "node scripts/check-public-routes.mjs",
    "smoke:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "@types/pg": "^8.23.1",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.555.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
