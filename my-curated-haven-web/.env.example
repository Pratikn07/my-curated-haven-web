# Phase 4 public Supabase credentials for local development and test environments.
# Do not add service-role keys, payment tokens, or production database secrets here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Local development can use the Supabase database started by `supabase start`.
# Vercel preview and production require an explicit COMMERCE_DATABASE_URL for the product database.
# COMMERCE_DATABASE_URL=

# Cloudflare Turnstile site key for the sign-in challenge. Leave unset locally,
# in CI and on previews: the form renders without the widget, and Supabase only
# enforces the challenge when the matching secret key is set on the project.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
